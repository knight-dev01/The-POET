{
  "rewrites": [
    { "source": "/((?!api|assets|uploads|sitemap\\.xml|robots\\.txt|rss\\.xml|favicon\\.svg|favicon\\.png|og\\.png|paper\\.svg|grid\\.svg|bg\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(paper|sprig|ornament|grid|favicon)\\.(svg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/og.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
